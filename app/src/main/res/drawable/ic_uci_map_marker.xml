<?xml version="1.0" encoding="utf-8"?>
<!--
    Marker for the osmdroid overlay.

    Deliberately NOT tinted with a theme attribute. OpenStreetMap's Mapnik
    tiles are light in both light and dark mode, so `?attr/colorOnSurfaceVariant`
    would resolve to a pale grey in dark mode and the pin would vanish against
    the map. A fixed dark teal with a white outline reads on light tiles under
    either theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- White outline first, so the pin survives a busy map. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1C7.58,1 4,4.58 4,9c0,5.83 7.4,13.7 7.4,13.7L12,23.4l0.6,-0.7C12.6,22.7 20,14.83 20,9c0,-4.42 -3.58,-8 -8,-8z" />
    <path
        android:fillColor="#FF00696E"
        android:pathData="M12,2.6C8.47,2.6 5.6,5.47 5.6,9c0,4.8 6.4,11.9 6.4,11.9S18.4,13.8 18.4,9C18.4,5.47 15.53,2.6 12,2.6zM12,11.5c-1.38,0 -2.5,-1.12 -2.5,-2.5S10.62,6.5 12,6.5s2.5,1.12 2.5,2.5S13.38,11.5 12,11.5z" />
</vector>
