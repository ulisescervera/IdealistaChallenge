<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon for API 24-25, which have no adaptive icons. API 26+ picks
    mipmap-anydpi-v26/ic_launcher.xml instead. Without this file, a minSdk 24
    device cannot resolve @mipmap/ic_launcher at all.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_uci_launcher_foreground"
        android:gravity="center" />
</layer-list>
