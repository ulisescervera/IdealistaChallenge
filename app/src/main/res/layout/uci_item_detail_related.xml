<?xml version="1.0" encoding="utf-8"?>
<!-- Section title + the horizontal carousel of related properties. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/uci_space_xl"
    android:paddingBottom="@dimen/uci_space_xxl">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/uci_space_l"
        android:text="@string/uci_detail_related_title"
        android:textAppearance="@style/TextAppearance.Uci.SectionTitle" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/uciRelatedEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/uci_space_l"
        android:paddingTop="@dimen/uci_space_s"
        android:text="@string/uci_detail_related_empty"
        android:textAppearance="@style/TextAppearance.Uci.Facts"
        android:visibility="gone"
        tools:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/uciRelatedList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/uci_space_s"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/uci_space_l"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="2"
        tools:listitem="@layout/uci_item_related_property" />

</LinearLayout>
