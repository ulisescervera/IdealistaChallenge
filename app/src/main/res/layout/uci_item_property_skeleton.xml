<?xml version="1.0" encoding="utf-8"?>
<!--
    Loading placeholder for a property row.

    It mirrors the real row's geometry — same card, same carousel height, same
    number of text lines — so the transition from skeleton to content does not
    make the list jump. That is the whole point of a skeleton over a spinner.

    The card is `importantForAccessibility="noHideDescendants"`: the *list* says
    "Cargando inmuebles" once, and a screen reader must not walk eight grey
    rectangles to find that out.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Uci.Card.Property"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/uci_space_l"
    android:layout_marginVertical="@dimen/uci_space_s"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.ulisescervera.uci.core.ui.skeleton.SkeletonView
            android:layout_width="match_parent"
            android:layout_height="@dimen/uci_carousel_height"
            app:uciSkeletonCornerRadius="0dp"
            app:uciSkeletonShape="rectangle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/uci_space_l">

            <com.ulisescervera.uci.core.ui.skeleton.SkeletonView
                android:layout_width="220dp"
                android:layout_height="@dimen/uci_skeleton_line_height_large"
                app:uciSkeletonShape="line" />

            <com.ulisescervera.uci.core.ui.skeleton.SkeletonView
                android:layout_width="150dp"
                android:layout_height="@dimen/uci_skeleton_line_height_large"
                android:layout_marginTop="@dimen/uci_space_s"
                app:uciSkeletonShape="line" />

            <com.ulisescervera.uci.core.ui.skeleton.SkeletonView
                android:layout_width="match_parent"
                android:layout_height="@dimen/uci_skeleton_line_height"
                android:layout_marginTop="@dimen/uci_space_m"
                app:uciSkeletonShape="line" />

            <com.ulisescervera.uci.core.ui.skeleton.SkeletonView
                android:layout_width="180dp"
                android:layout_height="@dimen/uci_skeleton_line_height"
                android:layout_marginTop="@dimen/uci_space_s"
                app:uciSkeletonShape="line" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
