<?xml version="1.0" encoding="utf-8"?>
<!--
    The map as the last page of the detail carousel.

    `uciCarouselMapTouchShield` sits on top of the MapView and is clickable but
    does not consume drags. That is what lets ViewPager2 keep intercepting
    horizontal swipes — a MapView with multi-touch enabled would eat them and
    the carousel would feel stuck on the last page.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant">

    <org.osmdroid.views.MapView
        android:id="@+id/uciCarouselMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/uciCarouselMapTouchShield"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/uciCarouselMapLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/uci_space_s"
        android:background="@drawable/bg_uci_page_indicator"
        android:drawableStart="@drawable/ic_uci_map_pin"
        android:drawablePadding="@dimen/uci_space_xs"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/uci_space_s"
        android:paddingVertical="@dimen/uci_space_xs"
        android:text="@string/uci_detail_map_title"
        android:textAppearance="@style/TextAppearance.Uci.Label"
        android:textColor="@android:color/white"
        app:drawableTint="@android:color/white" />

</FrameLayout>
