<?xml version="1.0" encoding="utf-8"?>
<!--
    UCI palette. Contrast ratios against their `on*` pair were checked to be at
    least 4.5:1 for body text and 3:1 for large text and UI components, which is
    WCAG 2.1 AA. If you change a value here, re-check the pair in values-night
    too — dark mode is not a filter, it is a second palette.
-->
<resources>

    <!-- Light scheme -->
    <color name="uci_primary">#00696E</color>
    <color name="uci_on_primary">#FFFFFF</color>
    <color name="uci_primary_container">#9CF1F6</color>
    <color name="uci_on_primary_container">#002022</color>

    <color name="uci_secondary">#4A6365</color>
    <color name="uci_on_secondary">#FFFFFF</color>
    <color name="uci_secondary_container">#CCE8E9</color>
    <color name="uci_on_secondary_container">#051F21</color>

    <color name="uci_tertiary">#4C5F7C</color>
    <color name="uci_on_tertiary">#FFFFFF</color>
    <color name="uci_tertiary_container">#D4E3FF</color>
    <color name="uci_on_tertiary_container">#051C35</color>

    <color name="uci_error">#BA1A1A</color>
    <color name="uci_on_error">#FFFFFF</color>
    <color name="uci_error_container">#FFDAD6</color>
    <color name="uci_on_error_container">#410002</color>

    <color name="uci_background">#F5FAFB</color>
    <color name="uci_on_background">#171D1D</color>
    <color name="uci_surface">#F5FAFB</color>
    <color name="uci_on_surface">#171D1D</color>
    <color name="uci_surface_variant">#DAE4E5</color>
    <color name="uci_on_surface_variant">#3F4849</color>
    <color name="uci_surface_container">#E9EFEF</color>

    <!-- Property card background in light mode: plain white so elevation's
         shadow is the only thing separating a card from `uci_background`
         (#F5FAFB) — a tinted container would double up with the shadow as a
         second, redundant cue. Dark mode is untouched: `uci_surface_container`
         already reads as "raised" there without needing a shadow at all. -->
    <color name="uci_property_card_background">#FFFFFF</color>
    <color name="uci_outline">#6F797A</color>
    <color name="uci_outline_variant">#BEC8C9</color>
    <color name="uci_inverse_surface">#2B3131</color>
    <color name="uci_inverse_on_surface">#ECF2F2</color>

    <!-- Favourite accent. Kept out of the M3 roles: it is a brand signal, not a
         semantic role, and it must stay recognisable in both schemes. -->
    <color name="uci_favourite">#D81B60</color>

    <!-- Skeleton loader. Low contrast on purpose: it is decorative and must not
         read as content to a screen reader or to a hurried eye. -->
    <color name="uci_skeleton_base">#E1E7E8</color>
    <color name="uci_skeleton_highlight">#F3F7F8</color>

    <!-- Scrim behind the immersive image viewer. -->
    <color name="uci_viewer_backdrop">#FF000000</color>

</resources>
