<?xml version="1.0" encoding="utf-8"?>
<!--
    Only registered by PropertyListFragment (a MenuProvider added with
    Lifecycle.State.RESUMED), so it is only visible while the list is the
    current destination — unlike the toolbar itself, a menu is not
    per-destination on its own.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/uci_menu_item_map"
        android:icon="@drawable/ic_uci_map"
        android:title="@string/uci_list_action_map"
        android:contentDescription="@string/uci_list_action_map"
        app:showAsAction="always" />

    <item
        android:id="@+id/uci_menu_item_filter"
        android:icon="@drawable/ic_uci_filter"
        android:title="@string/uci_list_action_filter"
        android:contentDescription="@string/uci_list_action_filter"
        app:showAsAction="always" />

</menu>
