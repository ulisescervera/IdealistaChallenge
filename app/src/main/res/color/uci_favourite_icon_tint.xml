<?xml version="1.0" encoding="utf-8"?>
<!--
    The favourite icon is tinted by state, not by swapping drawables, so the
    ripple and the state animation stay on a single view. `state_checked` is
    what MaterialButton with `checkable="true"` toggles.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/uci_favourite" android:state_checked="true" />
    <item android:alpha="0.38" android:color="?attr/colorOnSurfaceVariant" android:state_enabled="false" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
