<?xml version="1.0" encoding="utf-8"?>
<!-- `<monochrome>` (themed icons) exists from API 33; declaring it in the v26
     variant would put an unknown tag in front of API 26-32 inflaters. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_uci_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_uci_launcher_foreground" />
</adaptive-icon>
